{
  // Ships the static export in ./out as a Cloudflare Worker with static assets.
  // Build first (npm run build), then `npx wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "earth-and-ethos",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
